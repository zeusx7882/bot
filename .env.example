DISCORD_TOKEN=coloque_o_token_do_bot_aqui
DISCORD_CLIENT_ID=coloque_o_client_id_da_aplicacao_aqui
# Opcional: preencha para registrar os comandos apenas nesse servidor durante o desenvolvimento.
# Deixe em branco/remova para registrar os comandos globalmente (pode levar até 1h para propagar).
DISCORD_GUILD_ID=

# Diretório onde o arquivo do banco de dados SQLite será gravado (será criado automaticamente).
DATA_DIR=./data
