DISCORD_TOKEN=coloque_o_token_do_bot_aqui
DISCORD_CLIENT_ID=coloque_o_client_id_da_aplicacao_aqui
# Opcional: preencha para registrar os comandos apenas nesse servidor durante o desenvolvimento.
# Deixe em branco/remova para registrar os comandos globalmente (pode levar até 1h para propagar).
DISCORD_GUILD_ID=

# Diretório persistente do SQLite (relativo à raiz do projeto, ou absoluto).
DATA_DIR=./data

# Configuração IMAPS do servidor Mailcow do operador (não aceita host/porta via usuário).
MAILCOW_IMAP_HOST=imap.seu-dominio.test
MAILCOW_IMAP_PORT=993
# Domínios permitidos para autenticação (separados por vírgula).
MAILCOW_ALLOWED_DOMAINS=seu-dominio.test,outra-caixa.test

# Opcional (necessário para transcripts de tickets normais em logs).
# Também habilite Message Content Intent no Developer Portal.
MESSAGE_CONTENT_INTENT=0

# Sharpify (recurso /link_pagamento).
SHARPIFY_BASE_URL=https://api.sharpify.com.br
SHARPIFY_CLIENT_ID=sharpify_client_id_aqui
SHARPIFY_CLIENT_SECRET=sharpify_client_secret_aqui
# Obrigatório definir explicitamente a unidade para evitar ambiguidade da API:
# - minor: valor inteiro (ex.: 1500)
# - major: valor decimal (ex.: 15.00) com casas em SHARPIFY_MAJOR_DECIMALS
SHARPIFY_AMOUNT_UNIT=minor
SHARPIFY_MAJOR_DECIMALS=2
SHARPIFY_CURRENCY=BRL
SHARPIFY_TIMEOUT_MS=10000
